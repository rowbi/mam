{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mam",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
