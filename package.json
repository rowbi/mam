{
  "name": "mam-london",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "python3 -m http.server 8080 --directory dist",
    "deploy": "wrangler deploy",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 8080",
    "check:worker": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
